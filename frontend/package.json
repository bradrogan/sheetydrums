{
  "name": "sheetydrums-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VexFlow-based renderer for sheetydrums events.json",
  "scripts": {
    "schema:gen": "json2ts -i ../schema/events.schema.json -o src/generated/events.d.ts --no-additionalProperties && json2ts -i ../schema/project.schema.json -o src/generated/project.d.ts --no-additionalProperties --cwd ../schema",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "prebuild": "pnpm run schema:gen && pnpm run typecheck",
    "build": "vite build",
    "preview": "vite preview",
    "verify:tuning": "node scripts/verify-tuning.mjs"
  },
  "dependencies": {
    "vexflow": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
